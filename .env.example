# ============================================================
# Top World Premium — Variáveis de Ambiente (Back-end)
# ============================================================
# Copie este arquivo para ".env" e preencha as chaves.
# Sem nenhuma chave preenchida, o sistema funciona normalmente
# usando os dados de demonstração (mock) como fallback.

# --- API-Football (jogos, placares ao vivo, ligas) ---
# Crie a conta grátis em: https://dashboard.api-sports.io/register
# Pegue a chave em:        https://dashboard.api-sports.io/profile
# Plano grátis: 100 requisições/dia
API_FOOTBALL_KEY=

# --- The Odds API (odds das casas de apostas) ---
# Crie a chave grátis em: https://the-odds-api.com/#get-access
# Plano grátis: 500 requisições/mês
ODDS_API_KEY=

# --- Vercel Postgres (histórico de jogos) ---
# Crie o banco no painel da Vercel:
#   Dashboard > projeto "preditiva" > Storage > Create Database > Postgres
# A Vercel injeta estas variáveis automaticamente em produção.
# Para rodar localmente, copie a "POSTGRES_URL" do painel.
POSTGRES_URL=

# --- Segurança do Cron Job (opcional mas recomendado) ---
# Um segredo qualquer para proteger o endpoint /api/cron/refresh.
# A Vercel envia o header "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
